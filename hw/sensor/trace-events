# ltc2991.c
ltc2991_event(const char *id, const char *event) "%s: %s"
ltc2991_recv(const char *id, uint8_t reg, uint8_t data) "%s reg 0x%02x data: 0x%02x"
ltc2991_send(const char *id, uint8_t reg, uint8_t data) "%s reg: 0x%02x data: 0x%02x"
